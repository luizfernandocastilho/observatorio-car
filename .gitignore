.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini

# ========================================
# Dados das fontes (regra 6/9 do CLAUDE.md)
# dados_brutos/ fica fora do git; versiona-se só a estrutura e os LEIA-ME
# que explicam onde depositar cada fonte. Os arquivos reais (shapefiles,
# CSV, zips, geopackages) NUNCA entram no repositório.
# ========================================
dados_brutos/**
!dados_brutos/**/
!dados_brutos/**/LEIA-ME.txt

# Formatos de dado geoespacial/tabular pesado, em qualquer lugar
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.qix
*.gpkg
*.parquet
*.feather
